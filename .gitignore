# -----------------------------------------------------------------------------------------
# NOT ignored, deliberately:
#
#   api/              the generated stubs. A Go module is resolved straight from its version
#                     control tree - `go get` clones the tag and compiles what is in it, there
#                     is no build step in between. Ignoring the generated code here would
#                     publish an empty module.
#   go.mod / go.sum   the module manifest of the published module, for the same reason. They
#                     are written once by the proto compiler and maintained by hand afterwards.
# -----------------------------------------------------------------------------------------

# Compiled binaries and shared objects
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/

# Test binaries, profiles and coverage output
*.test
*.prof
coverage.out
generated-coverage.out
coverage.html

# Go workspace files - a local multi-module setup is never part of a release
go.work
go.work.sum

# Vendored dependencies: this module is consumed by `go get`, so its dependencies are resolved
# from the module cache, never vendored into the repository
vendor/

# Scratch file of `make check_build`
build_check.txt

# Credentials pulled in by `make ondewo_release`
ondewo-devops-accounts/

# Generated by editors
.idea
.vscode

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db
